# OPTIONAL. Everything works without a .env file because docker-compose.yml has safe
# defaults. Copy to `.env` only if you need to change something (it is git-ignored, never commit it).
#   Linux/macOS: cp .env.example .env        Windows PowerShell: copy .env.example .env

# Linux only, and only if `id -u` is not 1000: lets container files belong to you.
# UID=1000
# GID=1000

# POSTGRES_DB=spm
# POSTGRES_USER=spm
# POSTGRES_PASSWORD=spm

# DJANGO_SECRET_KEY=change-me   (required, and must be strong, in production)
